# E-OVRT Media Plane — Environment Variables
# Copy this file to .env and adjust as needed.
#
# Desde la Fase 1 (Spec A) el media-plane es un servicio (FastAPI) que sí lee
# configuración propia por variables de entorno EOVRT_* (ver
# src/eovrt_media/service/settings.py:ServiceSettings.from_env). El resto de
# la config de una corrida puntual (fuente, prompts, thresholds) viaja en el
# body de `POST /api/runs`, no por env vars.

# Ref del modelo a cargar una única vez al arrancar el servicio (catálogo
# configs/models/, o "mock" para validar sin pesos reales).
# OBLIGATORIA — el servicio no arranca (ValueError) si falta o está vacía.
EOVRT_MODEL_REF=mock

# Device de inferencia para el adapter (p.ej. "cuda", "cpu"). Opcional: si no
# se define, el adapter decide su propio default.
# EOVRT_MODEL_DEVICE=cuda

# Directorio donde se persisten los artefactos de cada corrida (detections.jsonl,
# metrics.jsonl, errors.jsonl, summary.json, previews/).
# Default: "runs" (relativo al CWD del proceso).
# EOVRT_RUNS_DIR=runs

# Raíz de datasets cross-repo para fuentes tipo image_folder que referencian el
# catálogo configs/datasets/ (p.ej. ../e-ovrt_datasets/datasets/raw/). Opcional.
# EOVRT_DATASETS_ROOT=/data/datasets

# Raíz de catálogos de capacidades del plano (configs/models/, configs/datasets/).
# Opcional: si no se define, se autodescubre repo-relative.
# EOVRT_MEDIA_CATALOG_ROOT=/app/configs

# Segundos sin progreso tras los cuales el watchdog de la corrida activa la
# marca como colgada (stall) y la corta. Default: 120.
# EOVRT_WATCHDOG_SECONDS=120

# Retención de runs/: edad máxima en días antes de elegibilidad para poda.
# Sin default — si no se define, no se poda por edad.
# EOVRT_RUNS_MAX_AGE_DAYS=30

# Retención de runs/: tamaño total máximo en GB antes de podar corridas viejas.
# Sin default — si no se define, no se poda por tamaño.
# EOVRT_RUNS_MAX_TOTAL_GB=50

# Segundos de gracia para shutdown limpio (SIGTERM) antes de forzar el corte
# de la corrida activa. Default: 20.
# EOVRT_SHUTDOWN_GRACE_SECONDS=20

# Umbral IoU de la evaluación BENCH (POST /api/runs/<id>/evaluate). Default: 0.5.
# EOVRT_EVAL_IOU_THRESHOLD=0.5

# --- Variables de terceros ---

# Hugging Face cache directory (optional)
# HF_HOME=/path/to/hf_cache

# Hugging Face token para descargas con mayor rate limit (optional)
# HF_TOKEN=hf_...
