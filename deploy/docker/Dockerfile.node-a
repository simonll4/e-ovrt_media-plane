# ⚠️ DEPRECADO / ROTO (Fase 1). Este artefacto define el despliegue two-node por Docker
# basado en el CLI `eovrt-media run-producer/run-consumer`, que fue ELIMINADO al pasar el
# media-plane a servicio (Spec A, Fase 1). El ENTRYPOINT/command de abajo NO arranca.
# El split two-node (imágenes edge sin GPU / GPU sobre ZeroMQ) se rehará en Fase 2.
# Para el servicio single-host de Fase 1 usá el `Dockerfile` de la raíz + `make serve`.

# Nodo A — ingesta + normalización + servidor ZeroMQ. Sin GPU.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[edge]"

ENTRYPOINT ["eovrt-media", "run-producer"]
CMD ["--config", "/app/deploy-configs/two_node_a.yaml"]
